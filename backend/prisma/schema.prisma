generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PRODUCTION_MANAGER
  LINE_SUPERVISOR
}

enum PlanStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

/** Process zones for Right-First-Time rework tracking */
enum ReworkZone {
  BLOW_MOULD
  FILLER
  CAPPER
  LABEL
  PACKAGING
  OTHER
}

enum ChangeoverKind {
  PLANNED
  UNPLANNED
}

enum ChangeoverStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  TARGET_MISSED
  HIGH_DOWNTIME
  MACHINE_BREAKDOWN
  PENDING_APPROVAL
  SYSTEM
}

enum ShiftClosingStatus {
  OPEN
  CLOSED
}

model User {
  id           String    @id @default(cuid())
  employeeId   String    @unique
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         Role      @default(LINE_SUPERVISOR)
  plantId      String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdById  String?
  updatedById  String?

  plant              Plant?              @relation(fields: [plantId], references: [id])
  supervisedLines    ProductionLine[]    @relation("LineSupervisor")
  productionPlans    ProductionPlan[]    @relation("PlanSupervisor")
  productionEntries  ProductionEntry[]   @relation("EntryCreator")
  approvedEntries    ProductionEntry[]   @relation("EntryApprover")
  downtimeEntries    DowntimeEntry[]
  changeoverEntries  ChangeoverEntry[]
  manpowerEntries    ManpowerEntry[]
  wasteEntries       WasteEntry[]
  salesEntries       SalesEntry[]
  pettyCashEntries   PettyCashEntry[]
  caseBookings       CaseBooking[]
  rftEntries         RftEntry[]          @relation("RftEntryCreator")
  shiftClosings      ShiftClosing[]
  notifications      Notification[]
  auditLogs          AuditLog[]          @relation("AuditActor")
  settingsUpdated    AppSetting[]

  @@index([role])
  @@index([plantId])
  @@index([deletedAt])
  @@map("users")
}

model Plant {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  location    String?
  timezone    String    @default("Asia/Kolkata")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  users           User[]
  lines           ProductionLine[]
  productionPlans ProductionPlan[]
  salesEntries    SalesEntry[]
  pettyCashEntries PettyCashEntry[]
  caseBookings    CaseBooking[]
  rftEntries      RftEntry[]

  @@index([deletedAt])
  @@map("plants")
}

model ProductionLine {
  id           String    @id @default(cuid())
  code         String    @unique
  name         String
  plantId      String
  supervisorId String?
  capacityCph  Float? // cases per hour capacity
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdById  String?
  updatedById  String?

  plant           Plant            @relation(fields: [plantId], references: [id])
  supervisor      User?            @relation("LineSupervisor", fields: [supervisorId], references: [id])
  machines        Machine[]
  productionPlans ProductionPlan[]
  changeoverEntries ChangeoverEntry[]
  wasteEntries    WasteEntry[]
  rftEntries      RftEntry[]

  @@index([plantId])
  @@index([supervisorId])
  @@index([deletedAt])
  @@map("production_lines")
}

model Brand {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  products Product[]
  salesEntries SalesEntry[]
  caseBookings CaseBooking[]

  @@index([deletedAt])
  @@map("brands")
}

model Product {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  brandId     String?
  description String?
  uom         String    @default("CASE")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  brand              Brand?            @relation(fields: [brandId], references: [id])
  skus               Sku[]
  productionPlans    ProductionPlan[]
  changeoversFrom    ChangeoverEntry[] @relation("ChangeoverFrom")
  changeoversTo      ChangeoverEntry[] @relation("ChangeoverTo")
  salesEntries       SalesEntry[]
  caseBookings       CaseBooking[]
  rftEntries         RftEntry[]

  @@index([brandId])
  @@index([deletedAt])
  @@map("products")
}

model Sku {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  productId   String
  packSize    Int? // bottles/units per case: 250ml=30, 500ml=24, 1000ml=12
  packVolume  String? // e.g. 250 ML, 500 ML
  bottlesPerHour Int? // rated line speed in bottles/hour (default 5400)
  casesPerPallet Int?
  netWeightKg Float?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  product         Product          @relation(fields: [productId], references: [id])
  productionPlans ProductionPlan[]
  changeoversFrom ChangeoverEntry[] @relation("ChangeoverFromSku")
  changeoversTo   ChangeoverEntry[] @relation("ChangeoverToSku")
  salesEntries    SalesEntry[]
  caseBookings    CaseBooking[]
  rftEntries      RftEntry[]

  @@index([productId])
  @@index([deletedAt])
  @@map("skus")
}

model Machine {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  lineId      String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  line            ProductionLine   @relation(fields: [lineId], references: [id])
  downtimeEntries DowntimeEntry[]

  @@index([lineId])
  @@index([deletedAt])
  @@map("machines")
}

model DowntimeCategory {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  reasons         DowntimeReason[]
  downtimeEntries DowntimeEntry[]

  @@map("downtime_categories")
}

model DowntimeReason {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  categoryId  String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  category        DowntimeCategory @relation(fields: [categoryId], references: [id])
  downtimeEntries DowntimeEntry[]

  @@index([categoryId])
  @@map("downtime_reasons")
}

model ChangeoverType {
  id           String    @id @default(cuid())
  code         String    @unique
  name         String
  standardMins Float
  description  String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  changeoverEntries ChangeoverEntry[]

  @@map("changeover_types")
}

model Shift {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  startTime   String // HH:mm
  endTime     String // HH:mm
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  productionPlans ProductionPlan[]
  shiftClosings   ShiftClosing[]
  wasteEntries    WasteEntry[]
  rftEntries      RftEntry[]

  @@map("shifts")
}

model ProductionPlan {
  id                   String     @id @default(cuid())
  planNumber           String     @unique
  productionDate       DateTime   @db.Date
  plantId              String
  lineId               String
  shiftId              String
  productId            String
  skuId                String
  batchNumber          String
  plannedCases         Float
  plannedOperatingMins Float
  plannedStartTime     DateTime
  plannedEndTime       DateTime
  plannedManpower      Int
  supervisorId         String?
  status               PlanStatus @default(SCHEDULED)
  remarks              String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?
  createdById          String?
  updatedById          String?

  plant             Plant              @relation(fields: [plantId], references: [id])
  line              ProductionLine     @relation(fields: [lineId], references: [id])
  shift             Shift              @relation(fields: [shiftId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  sku               Sku                @relation(fields: [skuId], references: [id])
  supervisor        User?              @relation("PlanSupervisor", fields: [supervisorId], references: [id])
  productionEntries ProductionEntry[]
  downtimeEntries   DowntimeEntry[]
  changeoverEntries ChangeoverEntry[]
  manpowerEntries   ManpowerEntry[]
  wasteEntries      WasteEntry[]
  shiftClosings     ShiftClosing[]

  @@index([productionDate])
  @@index([plantId, lineId, shiftId])
  @@index([supervisorId])
  @@index([status])
  @@index([deletedAt])
  @@index([deletedAt, productionDate])
  @@index([plantId, deletedAt, productionDate])
  @@map("production_plans")
}

model ProductionEntry {
  id              String      @id @default(cuid())
  planId          String
  hourStart       DateTime
  hourEnd         DateTime
  plannedCases    Float
  actualCases     Float
  goodCases       Float
  rejectCases     Float
  lossCases       Float       @default(0)
  remarks         String?
  status          EntryStatus @default(DRAFT)
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  approvalRemarks String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  plan          ProductionPlan @relation(fields: [planId], references: [id])
  createdBy     User           @relation("EntryCreator", fields: [createdById], references: [id])
  approvedBy    User?          @relation("EntryApprover", fields: [approvedById], references: [id])
  reworkEntries ReworkEntry[]

  @@index([planId])
  @@index([status])
  @@index([hourStart])
  @@index([deletedAt])
  @@index([planId, deletedAt, status])
  @@map("production_entries")
}

/** Zone-wise rework cases linked to an hourly production entry (separate from Hold) */
model ReworkEntry {
  id                 String     @id @default(cuid())
  productionEntryId  String
  zone               ReworkZone
  reworkCases        Float      @default(0)
  remarks            String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  productionEntry ProductionEntry @relation(fields: [productionEntryId], references: [id])

  @@unique([productionEntryId, zone])
  @@index([productionEntryId])
  @@index([zone])
  @@index([deletedAt])
  @@map("rework_entries")
}

model DowntimeEntry {
  id           String    @id @default(cuid())
  planId       String
  machineId    String?
  categoryId   String
  reasonId     String
  startTime    DateTime
  endTime      DateTime
  durationMins Float
  actionTaken  String?
  remarks      String?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  plan      ProductionPlan    @relation(fields: [planId], references: [id])
  machine   Machine?          @relation(fields: [machineId], references: [id])
  category  DowntimeCategory  @relation(fields: [categoryId], references: [id])
  reason    DowntimeReason    @relation(fields: [reasonId], references: [id])
  createdBy User              @relation(fields: [createdById], references: [id])

  @@index([planId])
  @@index([machineId])
  @@index([categoryId])
  @@index([startTime])
  @@index([deletedAt])
  @@index([planId, deletedAt])
  @@map("downtime_entries")
}

model ChangeoverEntry {
  id               String           @id @default(cuid())
  planId           String?
  lineId           String?
  productionDate   DateTime?        @db.Date
  changeoverTypeId String
  fromProductId    String
  toProductId      String
  fromSkuId        String?
  toSkuId          String?
  kind             ChangeoverKind   @default(PLANNED)
  status           ChangeoverStatus @default(COMPLETED)
  standardMins     Float
  actualMins       Float
  reason           String?
  remarks          String?
  startTime        DateTime?
  endTime          DateTime?
  createdById      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  plan           ProductionPlan? @relation(fields: [planId], references: [id])
  line           ProductionLine? @relation(fields: [lineId], references: [id])
  changeoverType ChangeoverType  @relation(fields: [changeoverTypeId], references: [id])
  fromProduct    Product         @relation("ChangeoverFrom", fields: [fromProductId], references: [id])
  toProduct      Product         @relation("ChangeoverTo", fields: [toProductId], references: [id])
  fromSku        Sku?            @relation("ChangeoverFromSku", fields: [fromSkuId], references: [id])
  toSku          Sku?            @relation("ChangeoverToSku", fields: [toSkuId], references: [id])
  createdBy      User            @relation(fields: [createdById], references: [id])

  @@index([planId])
  @@index([lineId])
  @@index([productionDate])
  @@index([kind])
  @@index([deletedAt])
  @@index([planId, deletedAt])
  @@index([lineId, productionDate, deletedAt])
  @@map("changeover_entries")
}

model ManpowerEntry {
  id           String   @id @default(cuid())
  planId       String
  headcount    Int
  operators    Int?
  helpers      Int?
  overtimeMins Float?   // overtime minutes for the shift crew
  remarks      String?
  recordedAt   DateTime @default(now())
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  plan      ProductionPlan @relation(fields: [planId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])

  @@index([planId])
  @@map("manpower_entries")
}

/** Raw-material waste catalog (Preform, Bottles, Cap, Stickers, Shrink Film) */
model WasteMaterial {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  defaultUnit String    @default("pcs")
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  entries WasteEntry[]

  @@index([deletedAt])
  @@map("waste_materials")
}

model WasteEntry {
  id              String   @id @default(cuid())
  wasteDate       DateTime @db.Date
  materialId      String
  quantity        Float // wastage qty
  actualQtyIssued Float? // quantity issued to line
  unit            String
  reason          String
  remarks         String?
  shiftId         String?
  lineId          String?
  planId          String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  material  WasteMaterial  @relation(fields: [materialId], references: [id])
  shift     Shift?         @relation(fields: [shiftId], references: [id])
  line      ProductionLine? @relation(fields: [lineId], references: [id])
  plan      ProductionPlan? @relation(fields: [planId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])

  @@index([wasteDate])
  @@index([materialId])
  @@index([shiftId])
  @@index([lineId])
  @@index([planId])
  @@index([deletedAt])
  @@map("waste_entries")
}

model ShiftClosing {
  id             String             @id @default(cuid())
  planId         String
  shiftId        String
  status         ShiftClosingStatus @default(OPEN)
  totalPlanned   Float?
  totalActual    Float?
  totalGood      Float?
  totalReject    Float?
  totalDowntime  Float?
  remarks        String?
  closedAt       DateTime?
  closedById     String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  plan     ProductionPlan @relation(fields: [planId], references: [id])
  shift    Shift          @relation(fields: [shiftId], references: [id])
  closedBy User           @relation(fields: [closedById], references: [id])

  @@unique([planId])
  @@index([shiftId])
  @@map("shift_closings")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  meta      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("app_settings")
}

enum SalesChannel {
  DISTRIBUTOR
  RETAIL
  MODERN_TRADE
  EXPORT
  OTHER
}

enum PaymentMode {
  CASH
  CREDIT
  ADVANCE
}

/** Party / distributor master — built from day-book sales names */
model Distributor {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  phone       String?
  area        String?
  remarks     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  salesEntries SalesEntry[]
  caseBookings CaseBooking[]

  @@index([name])
  @@index([deletedAt])
  @@map("distributors")
}

/** Daily / invoice-level sales for Sales Dashboard */
model SalesEntry {
  id            String       @id @default(cuid())
  saleDate      DateTime
  plantId       String?
  brandId       String?
  productId     String
  skuId         String
  distributorId String?
  channel       SalesChannel @default(DISTRIBUTOR)
  customerName  String?
  invoiceNo     String?
  paymentMode   PaymentMode  @default(CASH)
  casesSold     Float
  unitPrice     Float        @default(0)
  amount        Float        @default(0)
  remarks       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  createdById   String?
  updatedById   String?

  plant        Plant?        @relation(fields: [plantId], references: [id])
  brand        Brand?        @relation(fields: [brandId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  sku          Sku           @relation(fields: [skuId], references: [id])
  distributor  Distributor?  @relation(fields: [distributorId], references: [id])
  createdBy    User?         @relation(fields: [createdById], references: [id])
  caseBookings CaseBooking[]

  @@index([saleDate])
  @@index([plantId])
  @@index([brandId])
  @@index([productId])
  @@index([skuId])
  @@index([distributorId])
  @@index([channel])
  @@index([paymentMode])
  @@index([deletedAt])
  @@map("sales_entries")
}

enum CaseBookingStatus {
  BOOKED
  DELIVERED
  CANCELLED
}

/** Advance case booking — future delivery, separate from day-book sales */
model CaseBooking {
  id            String            @id @default(cuid())
  bookingDate   DateTime
  deliveryDate  DateTime
  plantId       String?
  brandId       String?
  productId     String
  skuId         String
  distributorId String?
  customerName  String?
  casesBooked   Float
  unitPrice     Float             @default(0)
  amount        Float             @default(0)
  status        CaseBookingStatus @default(BOOKED)
  remarks       String?
  salesEntryId  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  createdById   String?

  plant        Plant?       @relation(fields: [plantId], references: [id])
  brand        Brand?       @relation(fields: [brandId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  sku          Sku          @relation(fields: [skuId], references: [id])
  distributor  Distributor? @relation(fields: [distributorId], references: [id])
  salesEntry   SalesEntry?  @relation(fields: [salesEntryId], references: [id])
  createdBy    User?        @relation(fields: [createdById], references: [id])

  @@index([bookingDate])
  @@index([deliveryDate])
  @@index([plantId])
  @@index([productId])
  @@index([skuId])
  @@index([distributorId])
  @@index([status])
  @@index([deletedAt])
  @@map("case_bookings")
}

/** Petty cash book — voucher, received / paid, running balance */
model PettyCashEntry {
  id          String    @id @default(cuid())
  entryDate   DateTime
  voucherNo   String    @unique
  category    String
  description String
  received    Float     @default(0)
  paid        Float     @default(0)
  approvedBy  String?
  remarks     String?
  attachmentName String?
  attachmentMime String?
  attachmentPath String?
  plantId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  plant     Plant? @relation(fields: [plantId], references: [id])
  createdBy User?  @relation(fields: [createdById], references: [id])

  @@index([entryDate])
  @@index([category])
  @@index([plantId])
  @@index([deletedAt])
  @@map("petty_cash_entries")
}

/** RFT Reject Area master (Filling, Capping, Label, …) */
model RejectArea {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  shortLabel  String
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  types   RejectType[]
  rejects RftRejectQty[]

  @@index([sortOrder])
  @@index([deletedAt])
  @@map("reject_areas")
}

/** Reject type under an area (Underfill, Loose Cap, …) for Pareto */
model RejectType {
  id          String    @id @default(cuid())
  areaId      String
  code        String
  name        String
  example     String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  area    RejectArea     @relation(fields: [areaId], references: [id])
  rejects RftRejectQty[]

  @@unique([areaId, code])
  @@index([areaId])
  @@index([deletedAt])
  @@map("reject_types")
}

/**
 * Right First Time daily entry (Excel-style):
 * Total Produced + area-wise reject qty → FTG = Produced − Total Reject
 */
model RftEntry {
  id            String   @id @default(cuid())
  entryDate     DateTime @db.Date
  plantId       String?
  lineId        String
  shiftId       String
  productId     String
  skuId         String
  totalProduced Float
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  createdById   String?

  plant     Plant?          @relation(fields: [plantId], references: [id])
  line      ProductionLine  @relation(fields: [lineId], references: [id])
  shift     Shift           @relation(fields: [shiftId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  sku       Sku             @relation(fields: [skuId], references: [id])
  createdBy User?           @relation("RftEntryCreator", fields: [createdById], references: [id])
  rejects   RftRejectQty[]

  @@unique([entryDate, lineId, shiftId, skuId])
  @@index([entryDate])
  @@index([lineId])
  @@index([shiftId])
  @@index([productId])
  @@index([skuId])
  @@index([deletedAt])
  @@map("rft_entries")
}

model RftRejectQty {
  id           String   @id @default(cuid())
  rftEntryId   String
  areaId       String
  rejectTypeId String?
  quantity     Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  rftEntry   RftEntry    @relation(fields: [rftEntryId], references: [id])
  area       RejectArea  @relation(fields: [areaId], references: [id])
  rejectType RejectType? @relation(fields: [rejectTypeId], references: [id])

  @@index([rftEntryId])
  @@index([areaId])
  @@index([rejectTypeId])
  @@index([deletedAt])
  @@map("rft_reject_qtys")
}
